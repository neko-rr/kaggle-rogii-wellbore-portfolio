{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/before-shell-execution.ps1",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/pre-tool-use.ps1",
        "matcher": "Write|StrReplace|ApplyPatch|EditNotebook",
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/after-shell-execution.ps1",
        "matcher": "validate-submission\\.ps1"
      }
    ]
  }
}
